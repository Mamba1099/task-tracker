generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum Role {Y
  SUPERVISOR
  ATTACHE
}

enum PlacementStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  RETURNED
  COMPLETED
}

enum ReviewDecision {
  APPROVED
  RETURNED
}

// --- MODELS ---

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  placements Placement[]

  @@map("departments")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  departmentId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])

  // Relationships
  supervisedPlacements Placement[]   @relation("SupervisorPlacements")
  attachePlacements    Placement[]   @relation("AttachePlacements")
  createdTasks         Task[]        @relation("SupervisorTasks")
  assignedTasks        Task[]        @relation("AttacheTasks")
  taskUpdates          TaskUpdate[]
  taskReviews          TaskReview[]

  @@map("users")
}

model Placement {
  id           String          @id @default(cuid())
  attacheId    String
  supervisorId String
  departmentId String
  startDate    DateTime
  endDate      DateTime
  status       PlacementStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  attache    User       @relation("AttachePlacements", fields: [attacheId], references: [id])
  supervisor User       @relation("SupervisorPlacements", fields: [supervisorId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  tasks      Task[]

  @@map("attachment_placements")
}

model Task {
  id              String     @id @default(cuid())
  supervisorId    String
  attacheId       String
  placementId     String
  title           String
  description     String
  priority        Priority   @default(MEDIUM)
  dueDate         DateTime?
  status          TaskStatus @default(ASSIGNED)
  dateAssigned    DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  supervisor User          @relation("SupervisorTasks", fields: [supervisorId], references: [id])
  attache    User          @relation("AttacheTasks", fields: [attacheId], references: [id])
  placement  Placement     @relation(fields: [placementId], references: [id])
  updates    TaskUpdate[]
  reviews    TaskReview[]

  @@map("tasks")
}

model TaskUpdate {
  id               String   @id @default(cuid())
  taskId           String
  attacheId        String
  progressNote     String
  challengeBlocker String?
  createdAt        DateTime @default(now())

  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attache User @relation(fields: [attacheId], references: [id])

  @@map("task_updates")
}

model TaskReview {
  id           String         @id @default(cuid())
  taskId       String
  supervisorId String
  decision     ReviewDecision
  feedback     String?
  createdAt    DateTime       @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  supervisor User @relation(fields: [supervisorId], references: [id])

  @@map("task_reviews")
}